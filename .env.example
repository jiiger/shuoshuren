# ============================================================
#  说书人 B站弹幕自动发送  ——  配置模板 (.env.example)
#
#  使用方法：把本文件复制一份并改名为 .env（放在项目根目录，
#  与 main.py 同级），然后把下面的占位值替换成你自己的真实信息。
#
#  本模板不包含任何真实敏感信息，可以安全地提交到 Git / 分享。
# ============================================================

# ---------------- B站 账号 ----------------
# B站登录 Cookie（整段）：浏览器打开 bilibili.com 登录后，
# F12 开发者工具 → 网络(Network) → 刷新页面 → 点任意请求 →
# 在请求头(Request Headers) 里复制名为 Cookie 的那一整行（最长的那段）
BILIBILI_COOKIE="这里粘贴你的整段B站Cookie"

# CSRF Token：即上面 Cookie 里的 bili_jct 字段的值
BILIBILI_CSRF=你的bili_jct值

# 目标直播间房间号（填短号即可）
BILIBILI_ROOM_ID=14795951

# ---------------- QQ邮箱（异常通知用） ----------------
# SMTP 服务器地址（QQ 邮箱固定为 smtp.qq.com）
QQ_MAIL_HOST=smtp.qq.com
# SMTP 加密端口（QQ 邮箱固定为 465）
QQ_MAIL_PORT=465
# 发件 QQ 号（不含 @qq.com 后缀）
QQ_MAIL_USER=你的QQ号
# 发件邮箱完整地址
QQ_MAIL_SENDER=你的QQ号@qq.com
# QQ 邮箱 SMTP 授权码 —— 注意：不是 QQ 登录密码！
# 获取方式：QQ邮箱网页版 → 设置 → 账户 → 开启"SMTP服务" → 生成授权码
QQ_MAIL_AUTH_CODE=你的SMTP授权码
# 异常通知的接收邮箱，多个用英文逗号分隔
QQ_MAIL_RECEIVERS=接收通知的邮箱1,接收通知的邮箱2
